# ── Telegram (ZAROORI) ─────────────────────────────────────────────
# @BotFather se token lo  ->  /newbot
BOT_TOKEN=123456:ABC-your-bot-token-here
# https://my.telegram.org  ->  API development tools
API_ID=12345678
API_HASH=your-api-hash-here

# ── Download-source mode (4 options — koi bhi ek) ──────────────────
# MODE 1 (default, ZERO setup, ZERO cookie):
#   Kuch mat daalo — bot sechno.com (real TeraDL site) ke public API
#   se original file le lega. Kaam karta hai; speed provider ki hai
#   (aam ~100-250 KB/s is sandbox se — user ki server se fast).
#
# MODE 2 (RECOMMENDED — apna TeraDL website):
#   Is repo ka apna website/ folder deploy karo (README: "Apna TeraDL
#   website") — Render/Railway/VPS pe, FREE. Website link paste karo →
#   download/play UI + API deta hai. Bot usi API se direct baat karta
#   hai. Phir yahan website ka PUBLIC URL daalo:
# TERABOX_API_BASE=https://your-teradl-app.onrender.com
#
# MODE 3 (fastest — direct CDN, no proxy):
#   Ek free throwaway TeraBox account ka ndus cookie engine se uthao
#   (na tera account, na user ka — kisi ka bhi nahi, sirf engine ka).
#   Format:  ndus=VALUE   (ya sirf VALUE, ya poora cookie string)
TERABOX_COOKIE=

# ── Bot settings (optional) ────────────────────────────────────────
# Tera Telegram ID ( /id command se lo) — owner /stats ke liye
OWNER_ID=
# Khaali = sab users. Ya IDs comma se: 123456,891234  (private bot ke liye)
ALLOWED_USERS=
# Download folder
WORK_DIR=downloads
# Telegram bot max 2GB file bhej sakta hai
MAX_FILE_GB=2.0
# Har user ke do requests ka gap (seconds) — ban hone se bachav
RATE_LIMIT_SEC=60
# Ek saath kitne downloads
CONCURRENCY=3
BOT_NAME=TeraBox Downloader Bot
# Health check server (Koyeb/VPS monitoring) — GET /healthz
HEALTH_PORT=8080
